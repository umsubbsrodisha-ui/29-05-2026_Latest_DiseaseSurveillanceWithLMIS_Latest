@page "/patiententry"
@attribute [Authorize(Roles = "UPHCUser,CHCUser,UHWCUser,MO,DEO,Admin")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using MediatR
@using Surveillance.Application.Features.Cases.Commands
@using Surveillance.Application.Features.Cases.Queries
@using Surveillance.Application.Features.MasterData.Queries
@using Surveillance.Domain.Entities
@inject IJSRuntime JSRuntime

@inject IMediator Mediator
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Patient Entry</PageTitle>

<div class="container-fluid facility-page">

    @if (isLoading)
    {
        <div class="loading-card shadow-sm">
            <div class="spinner-border text-primary me-3"></div>
            <span class="fw-semibold">Loading master data...</span>
        </div>
    }
    else
    {
        <div class="case-header shadow-sm">
            <div>
                <div class="case-title-section">
                    <h2 class="case-title">
                        <i class="bi bi-person-plus-fill me-2"></i>
                        New Case Registration
                    </h2>

                    <span class="status-badge status-danger">
                        Surveillance Entry
                    </span>
                </div>

                <div class="case-subtitle">
                    Facility : @facilityName
                </div>
            </div>
        </div>

        <div class="case-card shadow-sm">
            <EditForm Model="caseEntry" >
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="section-card">
                    <div class="section-title">
                        <i class="bi bi-person-fill me-2"></i>
                        Patient Information
                    </div>

                    <div class="details-grid">

                        <div class="detail-item">
                            <div class="detail-label">Patient Name</div>
                            <InputText @bind-Value="caseEntry.PatientName"
                                       class="form-control" />
                        </div>

                        <div class="detail-item">
                            <div class="detail-label">Phone Number</div>
                            <InputText @bind-Value="caseEntry.Phone"
                                       class="form-control" />
                        </div>

                        <div class="detail-item">
                            <div class="detail-label">Disease</div>
                            <InputText @bind-Value="caseEntry.DiseaseName"
                                       class="form-control" />
                        </div>

                        <div class="detail-item">
                            <div class="detail-label">Symptom Start Date</div>
                            <InputDate @bind-Value="caseEntry.OnsetDate"
                                       class="form-control" />
                        </div>

                        <div class="detail-item">
                            <div class="detail-label">Date Reported</div>
                            <InputDate @bind-Value="caseEntry.DateReported"
                                       class="form-control" />
                        </div>

                    </div>

                    <div class="mt-3">
                        <div class="detail-label">Patient Address</div>

                        <InputTextArea @bind-Value="caseEntry.AddressOfPatient"
