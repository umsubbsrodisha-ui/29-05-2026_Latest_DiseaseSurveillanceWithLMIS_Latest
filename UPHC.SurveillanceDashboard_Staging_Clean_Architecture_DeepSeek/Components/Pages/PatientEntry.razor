@* @page "/patiententry"
@attribute [Authorize(Roles = "UPHCUser,CHCUser,UHWCUser,Admin")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using MediatR
@using Surveillance.Application.Features.Cases.Commands
@using Surveillance.Domain.Entities

@inject IMediator Mediator
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Case Entry</PageTitle>

<div class="container mt-4">
    <EditForm Model="caseEntry" OnValidSubmit="HandleSave" class="card p-4">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <h4>Enter Case Details (@uphcName)</h4>

        <div class="mb-3">
            <label>Patient Name</label>
            <InputText @bind-Value="caseEntry.PatientName" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Phone Number</label>
            <InputText @bind-Value="caseEntry.Phone" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Date when symptoms started</label>
            <InputDate @bind-Value="caseEntry.OnsetDate"
                       class="form-control"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>

        <div class="mb-3">
            <label>Date of Patient Visit</label>
            <InputDate @bind-Value="caseEntry.DateReported"
                       class="form-control"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>

        <div class="mb-3">
            <label>Symptoms</label>
            <InputTextArea @bind-Value="caseEntry.Symptoms"
                           class="form-control"
                           rows="3" />
        </div>

        <div class="mb-3">
            <label>Disease</label>
            <InputSelect @bind-Value="selectedDisease" class="form-control">
                <option value="">-- Select Disease --</option>
                @foreach (var d in outbreakDiseases)
                {
                    <option value="@d">@d</option>
                }
                <option value="Other">Other</option>
            </InputSelect>
        </div>

        @if (selectedDisease == "Other")
        {
            <div class="mb-3">
                <label>Enter Disease Name</label>
                <InputText @bind-Value="caseEntry.DiseaseName" class="form-control" />
            </div>
        }

        <div class="mb-3">
            <label>Address</label>
            <InputTextArea @bind-Value="caseEntry.AddressOfPatient"
                           class="form-control"
                           rows="2" />
        </div>

        <button type="submit" class="btn btn-success btn-lg" disabled="@isSaving">
            @(isSaving ? "Saving..." : "Save Case Record")
        </button>
    </EditForm>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="custom-alert-overlay">
            <div class="custom-alert-box @(success ? "success" : "error")">
                <div class="alert-icon">
                    @(success ? "✔️" : "❌")
                </div>
                <div class="alert-text">
                    @message
                </div>
                <button class="alert-close" @onclick="CloseAlert">OK</button>
            </div>
        </div>
    }
</div>

@code {
    CreateCaseCommand caseEntry = new();
    string? message = "";
    bool success = false;
    bool isSaving = false;
    string uphcName = "";
    string selectedDisease = "";

    List<string> outbreakDiseases = new()
    {
        "Dengue","Malaria","Chikungunya","Zika Virus Disease","COVID-19",
        "Influenza (ILI/SARI)","Tuberculosis","Measles","Rubella",
        "Varicella (Chickenpox)","Mumps","Diphtheria",
        "Pertussis (Whooping Cough)","Acute Flaccid Paralysis (Polio)",
        "Meningitis","AES/JE","Cholera","ADD","Typhoid",
        "Hepatitis A & E","Hepatitis B","Hepatitis C","Leptospirosis",
        "Scrub Typhus","Rabies","Tetanus","Plague","Anthrax","Brucellosis",
        "Kala-azar","Filariasis","Leprosy","HIV/AIDS","HFMD"
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var appUser = await UserManager.GetUserAsync(user);

        if (appUser?.FacilityId != null)
        {
            // Set user info in command
            caseEntry.UserId = appUser.Id;
            caseEntry.FacilityId = appUser.FacilityId.Value;
            uphcName = "Facility " +appUser?.FacilityId;
        }
    }

    private async Task HandleSave()
    {
        if (isSaving) return;
        isSaving = true;

        try
        {
            if (string.IsNullOrWhiteSpace(selectedDisease))
            {
                message = "Please select a disease!";
                success = false;
                return;
            }

            caseEntry.DiseaseName = selectedDisease == "Other"
                ? caseEntry.DiseaseName
                : selectedDisease;

            var caseId = await Mediator.Send(caseEntry);

            success = true;
            message = "Case saved successfully!";

            caseEntry = new CreateCaseCommand
            {
                UserId = caseEntry.UserId,
                FacilityId = caseEntry.FacilityId
            };
            selectedDisease = "";
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            success = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    void CloseAlert()
    {
        message = null;
    }
}

 *@







































