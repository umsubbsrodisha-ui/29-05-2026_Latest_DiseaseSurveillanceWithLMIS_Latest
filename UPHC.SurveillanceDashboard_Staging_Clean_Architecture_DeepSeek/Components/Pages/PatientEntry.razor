@* @page "/patient-entry"
@attribute [Authorize(Roles = "UPHCUser")]
@inject NotificationService NotifService
@inject IDbContextFactory<AppDbContext> DbFactory
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using UPHC.SurveillanceDashboard.Data
@using UPHC.SurveillanceDashboard.Services
@using UPHC.SurveillanceDashboard.Models
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Identity;
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Patient Entry</PageTitle>

<div class="container mt-4">
    <EditForm Model="patient" OnValidSubmit="HandleSave" class="card p-4">
        <h4>Enter Patient Details (UPHC1)</h4>
        <div class="mb-3">
            <label>Patient Name</label>
            <InputText @bind-Value="patient.Name" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Phone Number</label>
            <InputText @bind-Value="patient.Phone" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Symptoms</label>
            <InputTextArea @bind-Value="patient.Symptoms" class="form-control" rows="3" />
        </div>
        <div class="mb-3">
            <label>Disease Name</label>
            <InputText @bind-Value="patient.DiseaseName" class="form-control" />
        </div>
        <div class="mb-3 form-check">
            <InputCheckbox @bind-Value="patient.IsCommunicable" class="form-check-input" />
            <label class="form-check-label">Communicable Disease?</label>
        </div>
        <button type="submit" class="btn btn-success btn-lg">Save Patient Record</button>
    </EditForm>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(success ? "alert-success" : "alert-info") mt-3">@message</div>
    }
</div>

@code {
    CaseRecord patient = new() { UPHCId = 1 };  // UPHC1 hardcoded for demo
    string message = "";
    bool success = false;

    private async Task HandleSave()
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            
            // Save patient record

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            patient.UserId = user.Identity?.Name ?? "DemoUser";


            patient.CreatedDate = DateTime.Now;
          //  patient.UserId = User.Identity?.Name ?? "DemoUser";
            db.Patients.Add(patient);
            await db.SaveChangesAsync();

            UPHC? uphc = await db.UPHCs.FindAsync(patient.UPHCId);
            string uphcName = uphc?.Name ?? "Unknown UPHC";

            // CRITICAL: TRIGGER NOTIFICATION IF COMMUNICABLE
            if (patient.IsCommunicable)
            {
                await NotifService.SendNotification(uphcName, patient.DiseaseName);
                message = $"Patient '{patient.Name}' saved. ALERT: {patient.DiseaseName} notification sent to Analyst!";
            }
            else
            {
                message = $"Patient '{patient.Name}' saved (non-communicable).";
            }

            success = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            success = false;
        }
    }
} *@