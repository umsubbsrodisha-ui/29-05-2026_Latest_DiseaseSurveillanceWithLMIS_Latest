@code {
    [Parameter] public int id { get; set; }

    List<CaseRecord>? cases;   //changes made due to warning "Dereference of a possibly null reference" in line 24 and 25
    string FacilityName = "";
    string FacilityAddress = "";

    int currentPage = 1;
    int pageSize = 10;

    protected override async Task OnParametersSetAsync()
    {
        using var db = DbFactory.CreateDbContext();

        var facility = await db.Facilities.FindAsync(id);
        if (facility != null)
        {
           FacilityName = facility.FacilityName;
            FacilityAddress = facility.FacilityAddress;
        }

        await LoadCases();
    }

    async Task LoadCases()
    {
        using var db = DbFactory.CreateDbContext();

        cases = await db.CaseRecords
            .Where(c => c.FacilityId == id)
            .OrderByDescending(c => c.CreatedDate)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();
    }

    async Task NextPage()
    {
        currentPage++;
        await LoadCases();
    }

    async Task PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadCases();
        }
    }

    void OpenCase(int caseId)
    {
        Navigation.NavigateTo($"/case-details/{caseId}");
    }
} *@