@* @page "/lab-report/{LabResultId:guid}"
@attribute [Authorize(Roles = "MO,MB,Admin,Analyst")]

@using MediatR
@using Microsoft.AspNetCore.Authorization
@using Surveillance.Application.DTOs
@using Surveillance.Application.Features.Lab.Queries

@inject IMediator Mediator

<PageTitle>Lab Report</PageTitle>

@if (isLoading)
{
    <div class="loading-card shadow-sm">
        <div class="spinner-border text-primary me-3"></div>
        <span class="fw-semibold">Loading lab report...</span>
    </div>
}
else if (report == null)
{
    <div class="alert alert-danger">
        Report not found.
    </div>
}
else
{
    <div class="container-fluid">

        <div class="report-card shadow-lg">

            <!-- HEADER -->
            <div class="report-header">

                <div>
                    <h2 class="mb-1">
                        Laboratory Report
                    </h2>

                    <div class="small opacity-75">
                        Integrated Disease Surveillance Programme
                    </div>
                </div>

                <div class="text-end">
                    <div class="badge bg-light text-dark fs-6 px-3 py-2">
                        @report.ResultStatus
                    </div>
                </div>

            </div>

            <!-- BODY -->
            <div class="report-body">

                <!-- PATIENT -->
                <div class="section-card">

                    <div class="section-title">
                        Patient Information
                    </div>

                    <div class="row g-3">

                        <div class="col-md-4">
                            <label>Name</label>
                            <div>@report.PatientName</div>
                        </div>

                        <div class="col-md-4">
                            <label>Phone</label>
                            <div>@report.Phone</div>
                        </div>

                        <div class="col-md-4">
                            <label>Disease</label>
                            <div>@report.DiseaseName</div>
                        </div>

                    </div>
                </div>

                <!-- SAMPLE -->
                <div class="section-card">

                    <div class="section-title">
                        Sample Information
                    </div>

                    <div class="row g-3">

                        <div class="col-md-4">
                            <label>Facility</label>
                            <div>@report.FacilityName</div>
                        </div>

                        <div class="col-md-4">
                            <label>Sample Type</label>
                            <div>@report.SampleTypeName</div>
                        </div>

                        <div class="col-md-4">
                            <label>Barcode</label>
                            <div>@report.SampleBarcode</div>
                        </div>

                    </div>
                </div>

                <!-- RESULT -->
                <div class="section-card">

                    <div class="section-title">
                        Test Result
                    </div>

                    <div class="row g-3">

                        <div class="col-md-4">
                            <label>Lab Test</label>
                            <div>@report.LabTestName</div>
                        </div>

                        <div class="col-md-4">
                            <label>Result</label>

                            <div class="fw-bold
                                @(report.ResultStatus == "Positive"
                                                                     ? "text-danger"
                                                                     : "text-success")">

                                @report.ResultValue
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label>Verified</label>
                            <div>
                                @(report.IsVerified ? "Yes" : "No")
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label>Remarks</label>

                            <div class="remarks-box">
                                @(string.IsNullOrWhiteSpace(report.Remarks)
                                    ? "No remarks"
                                    : report.Remarks)
                            </div>
                        </div>

                    </div>
                </div>

                <!-- FOOTER -->
                <div class="report-footer">

                    <div>
                        Generated:
                        @report.EnteredAt.ToString("dd MMM yyyy HH:mm")
                    </div>

                    <button class="btn btn-primary"
                            @onclick="PrintReport">
                        Print Report
                    </button>

                </div>

            </div>

        </div>

    </div>
}

@code {

    [Parameter]
    public Guid LabResultId { get; set; }

    private bool isLoading = true;

    private LabReportDto? report;

    protected override async Task OnInitializedAsync()
    {
        report = await Mediator.Send(
            new GetLabReportByIdQuery
            {
                LabResultId = LabResultId
            });

        isLoading = false;
    }

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;
} *@